<Window x:Class="OmniAudioTranslator.App.Views.DisplaySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" Height="540"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <ScrollViewer Margin="16" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock x:Name="HeaderText" FontSize="18" FontWeight="Bold" Margin="0,0,0,4" />
            <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,16" />

            <TextBlock x:Name="StatusSectionHeader" FontWeight="Bold" Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <CheckBox x:Name="StatusShowCheck" VerticalAlignment="Center"
                          Checked="OnControlChanged" Unchecked="OnControlChanged" />
                <TextBlock x:Name="StatusSizeLabel" VerticalAlignment="Center" Margin="16,0,4,0" />
                <TextBox x:Name="StatusSizeBox" Width="50" TextChanged="OnControlChanged" />
                <TextBlock x:Name="StatusColorLabel" VerticalAlignment="Center" Margin="16,0,4,0" />
                <Button x:Name="StatusColorSwatch" Width="28" Height="20" Click="StatusColorSwatch_Click" />
            </StackPanel>

            <TextBlock x:Name="SourceSectionHeader" FontWeight="Bold" Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <CheckBox x:Name="SourceShowCheck" VerticalAlignment="Center"
                          Checked="OnControlChanged" Unchecked="OnControlChanged" />
                <TextBlock x:Name="SourceSizeLabel" VerticalAlignment="Center" Margin="16,0,4,0" />
                <TextBox x:Name="SourceSizeBox" Width="50" TextChanged="OnControlChanged" />
                <TextBlock x:Name="SourceColorLabel" VerticalAlignment="Center" Margin="16,0,4,0" />
                <Button x:Name="SourceColorSwatch" Width="28" Height="20" Click="SourceColorSwatch_Click" />
            </StackPanel>

            <TextBlock x:Name="TranslatedSectionHeader" FontWeight="Bold" Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <CheckBox x:Name="TranslatedShowCheck" VerticalAlignment="Center"
                          Checked="OnControlChanged" Unchecked="OnControlChanged" />
                <TextBlock x:Name="TranslatedSizeLabel" VerticalAlignment="Center" Margin="16,0,4,0" />
                <TextBox x:Name="TranslatedSizeBox" Width="50" TextChanged="OnControlChanged" />
                <TextBlock x:Name="TranslatedColorLabel" VerticalAlignment="Center" Margin="16,0,4,0" />
                <Button x:Name="TranslatedColorSwatch" Width="28" Height="20" Click="TranslatedColorSwatch_Click" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock x:Name="OpacityLabel" VerticalAlignment="Center" />
                <TextBlock x:Name="OpacityValueText" Text="0.59" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
            <Slider x:Name="OpacitySlider" Minimum="0" Maximum="1" Margin="0,0,0,20"
                    ValueChanged="OpacitySlider_ValueChanged" />

            <Button x:Name="ResetButton"
                    HorizontalAlignment="Left" Padding="12,6" Click="ResetButton_Click" />

            <Popup x:Name="ColorPalettePopup" Placement="Bottom" StaysOpen="False">
                <Border Background="#FF2D2D30" BorderBrush="Gray" BorderThickness="1" Padding="6">
                    <UniformGrid x:Name="ColorPaletteGrid" Columns="6" />
                </Border>
            </Popup>
        </StackPanel>
    </ScrollViewer>
</Window>

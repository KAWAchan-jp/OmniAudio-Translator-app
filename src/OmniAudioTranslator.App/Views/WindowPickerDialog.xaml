<Window x:Class="OmniAudioTranslator.App.Views.WindowPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="500" Width="580"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="DescriptionText" Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap" />

        <GroupBox x:Name="KeywordGroup" Grid.Row="1" Margin="0,0,0,8">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="KeywordLabel" VerticalAlignment="Center" />
                    <TextBox x:Name="KeywordTextBox" Width="220" Margin="8,0,8,0"
                             VerticalContentAlignment="Center"
                             KeyDown="KeywordTextBox_KeyDown" />
                    <Button x:Name="AddKeywordButton" Width="72" Click="AddKeywordButton_Click" />
                </StackPanel>

                <ItemsControl x:Name="KeywordItemsControl" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <TextBlock x:Name="KeywordHintText" Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="#FF666666" />
            </StackPanel>
        </GroupBox>

        <ListBox x:Name="WindowListBox" Grid.Row="2"
                 MouseDoubleClick="WindowListBox_MouseDoubleClick">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="3,2" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                            <Setter Property="Background" Value="#FFFFF1A8" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayText}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="RefreshButton" Width="80" Margin="0,0,8,0" Click="RefreshButton_Click" />
            <Button x:Name="SelectButton" Width="80" Margin="0,0,8,0" IsDefault="True" Click="OkButton_Click" />
            <Button x:Name="CancelButton" Width="80" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="OmniAudioTranslator.App.Views.WindowPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="420" Width="520"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="DescriptionText" Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap" />

        <ListBox x:Name="WindowListBox" Grid.Row="1"
                 DisplayMemberPath="DisplayText"
                 MouseDoubleClick="WindowListBox_MouseDoubleClick" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="RefreshButton" Width="80" Margin="0,0,8,0" Click="RefreshButton_Click" />
            <Button x:Name="SelectButton" Width="80" Margin="0,0,8,0" IsDefault="True" Click="OkButton_Click" />
            <Button x:Name="CancelButton" Width="80" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
